{
  "manifest_version": 3,
  "name": "YouTube 中段縮圖",
  "version": "1.2.0",
  "description": "把 YouTube 的影片縮圖換成影片中段（第 2 幀）的畫面；首頁、搜尋結果與推薦列都會套用。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "thumb-core.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "YouTube 中段縮圖",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_ui": {
    "page": "popup.html",
    "open_in_tab": true
  }
}
